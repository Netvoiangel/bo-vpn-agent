TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# The server currently needs its existing HTTP(S) proxy to reach Telegram.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=bo-vpn-worker,univpn-service,127.0.0.1,localhost

# Optional MVP settings.
BO_VPN_WORKER_URL=http://bo-vpn-worker:8000
BO_VPN_WORKER_AUTH_TOKEN=dev-token
AUDIO_DEFAULT_VOLUME=25
AUDIO_DEFAULT_OUTPUT=salon
VEHICLE_MAP_PATH=/app/config/vehicle_ip_map.csv
