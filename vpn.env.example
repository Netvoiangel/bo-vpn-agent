# ==========================================
# UniVPN Standalone Deployment Configuration
# ==========================================

# Docker image for UniVPN (pre-built / imported from vendor package or registry)
UNIVPN_IMAGE=local/univpn:10781.16.0.0730

# Host paths for persistent UniVPN data and secrets
UNIVPN_PROFILE_DIR=/opt/univpn/profile
UNIVPN_SECRET_FILE=/opt/univpn/secret.env
UNIVPN_LOGS_DIR=/opt/univpn/logs
BO_VPN_SSH_KEYS_DIR=/opt/univpn/keys
BO_VPN_SSH_KEY_PATH=/run/keys/rsa.key

# UniVPN Connection Profile Menu Index (default is 3 for the first configured profile)
BO_VPN_UNIVPN_PROFILE_MENU_INDEX=3

# Worker API Authentication & Configuration
BO_VPN_WORKER_AUTH_TOKEN=change-me-to-a-secure-random-token
BO_VPN_WORKER_PORT=8000

# TCP Proxy Port on Host loopback (127.0.0.1)
VPN_TCP_PROXY_PORT=18080
VPN_TCP_PROXY_LOG_LEVEL=INFO

# Default SSH user for remote vehicles
BO_VPN_DEFAULT_SSH_USER=root
